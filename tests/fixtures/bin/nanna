#!/bin/sh
D=$(dirname "$0")
cfg() { if [ -f "$D/$1" ]; then cat "$D/$1"; else printf '%s' "$2"; fi; }
if [ "$1" = agents ]; then
  printf 'NAME LOOP MODEL MAX_EFFECT\n'
  for name in $(cfg identities "auditor rust-implementer"); do printf '%s inner m workspace\n' "$name"; done
  exit 0
fi
[ "$1" = mcp-serve ] || exit 9
FIX=$(cfg fixtures "")
STATE=$(cfg state task_completed)
RESULT=$(cfg result result_success)
reply() { printf '{"jsonrpc":"2.0","id":%s,"result":%s}\n' "$1" "$(tr -d '\n' < "$FIX/$2.json")"; }
while read -r line; do
  id=$(printf '%s' "$line" | grep -o '"id":[0-9]*' | head -1 | cut -d: -f2)
  case "$line" in
    *'"method":"initialize"'*) reply "$id" initialize_result ;;
    *'"method":"tools/call"'*) : > "$D/started"; reply "$id" create_task_result ;;
    *'"method":"tasks/cancel"'*) : > "$D/cancelled"; reply "$id" task_cancelled ;;
    *'"method":"tasks/get"'*) reply "$id" "$STATE" ;;
    *'"method":"tasks/result"'*) reply "$id" "$RESULT" ;;
  esac
done
