#!/bin/sh
D=$(dirname "$0")
cfg() { if [ -f "$D/$1" ]; then cat "$D/$1"; else printf '%s' "$2"; fi; }
case "$1 $2" in
  "issue view") echo '{"number":5,"title":"Do it","body":"please","labels":[{"name":"inchworm"}],"url":"https://github.com/o/r/issues/5"}' ;;
  "issue list") cfg issues '[]'; echo ;;
  "issue edit"|"issue comment") ;;
  "label list") cfg labels '[{"name":"inchworm"},{"name":"inchworm:running"},{"name":"inchworm:failed"},{"name":"inchworm:done"}]'; echo ;;
  "pr list") cfg prs '[{"number":9,"headRefOid":"abc123","isDraft":true,"state":"OPEN","url":"https://github.com/o/r/pull/9"}]'; echo ;;
  "pr view") cfg prview '{"number":9,"headRefOid":"abc123","isDraft":true,"state":"OPEN","url":"https://github.com/o/r/pull/9"}'; echo ;;
  "pr diff") cfg patch 'diff --git a/src/lib.rs b/src/lib.rs
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -1 +1,2 @@
+/// doc
 pub fn f() {}'; echo ;;
  "api --paginate") case "$3" in
    */check-runs) cfg checks ''; echo ;;
    *) cfg files 'src/lib.rs'; echo ;;
  esac ;;
  "api repos/"*) case "$2" in
    */required_status_checks) if [ -f "$D/protection" ]; then cat "$D/protection"; else echo "gh: Branch not protected (HTTP 404)" >&2; exit 1; fi ;;
    *) echo "unexpected gh $*" >&2; exit 1 ;;
  esac ;;
  *) echo "unexpected gh $*" >&2; exit 1 ;;
esac
