[Unit]
Description=inchworm local coding agent orchestrator
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
Environment=PATH=%h/.nix-profile/bin:%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NANNA_CONFIG_DIR=%h/.config/nanna
ExecStart=%h/.cargo/bin/inchworm daemon
EnvironmentFile=-%h/.config/inchworm/env
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
NoNewPrivileges=yes
RestrictSUIDSGID=yes
UMask=0077

[Install]
WantedBy=default.target
